diff --git a/web/src/domains/conta/repositories/cliente-perfil.repository.ts b/web/src/domains/conta/repositories/cliente-perfil.repository.ts
new file mode 100644
index 0000000..390e4f0
--- /dev/null
+++ b/web/src/domains/conta/repositories/cliente-perfil.repository.ts
@@ -0,0 +1,57 @@
+import { supabase } from '@/lib/supabase'
+
+export interface ClientePerfilRow {
+  id: number
+  nome: string | null
+  email: string | null
+  telefone: string | null
+  auth_user_id?: string | null
+}
+
+export interface ClientePerfilInput {
+  nome?: string
+  telefone?: string | null
+}
+
+export interface ClientePerfilRepository {
+  buscarPorEmail(email: string): Promise<ClientePerfilRow | null>
+  buscarPorAuthUserId(authUserId: string): Promise<ClientePerfilRow | null>
+  atualizar(id: number, input: ClientePerfilInput): Promise<ClientePerfilRow | null>
+}
+
+export const clientePerfilRepository: ClientePerfilRepository = {
+  async buscarPorEmail(email) {
+    if (!email) return null
+    const { data, error } = await supabase
+      .from('cliente')
+      .select('id, nome, email, telefone, auth_user_id')
+      .eq('email', email)
+      .maybeSingle()
+    if (error) return null
+    return (data as ClientePerfilRow | null) ?? null
+  },
+  async buscarPorAuthUserId(authUserId) {
+    if (!authUserId) return null
+    const { data, error } = await supabase
+      .from('cliente')
+      .select('id, nome, email, telefone, auth_user_id')
+      .eq('auth_user_id', authUserId)
+      .maybeSingle()
+    if (error) return null
+    return (data as ClientePerfilRow | null) ?? null
+  },
+  async atualizar(id, input) {
+    const payload: Record<string, string | null> = {}
+    if (input.nome !== undefined) payload.nome = input.nome
+    if (input.telefone !== undefined) payload.telefone = input.telefone
+    if (Object.keys(payload).length === 0) return null
+    const { data, error } = await supabase
+      .from('cliente')
+      .update(payload)
+      .eq('id', id)
+      .select('id, nome, email, telefone, auth_user_id')
+      .maybeSingle()
+    if (error) return null
+    return (data as ClientePerfilRow | null) ?? null
+  },
+}
